{
  "name": "@lasso/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tyndt serverlag: MCP-server (Streamable HTTP), Lasso-datalag, gemte visninger og delte sider.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
