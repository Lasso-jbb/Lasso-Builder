# Kopiér til .env lokalt. På Railway sættes de som service-variabler.
APP_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Postgres. Tom = gemte visninger holdes i hukommelsen.
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Beskytter /mcp og admin-/debug-ruterne. Tom = åben (kun lokalt).
MCP_ACCESS_KEY=
ADMIN_API_KEY=
# Signerer links til interaktive virksomhedsvisninger (/k/<cvr>). Tom = afledes af MCP_ACCESS_KEY.
LINK_SECRET=
LINK_TTL_DAYS=30

# Gem-laget (docs/gem-lag.md): flere adgangsnøgler til /mcp, hver bundet til en bruger, så gemte
# sider er personlige uden OAuth. Format: "nøgle:bruger-id:Navn:org;nøgle2:id2" (navn og org kan
# udelades; org = DEMO_ORG). Tom = kun MCP_ACCESS_KEY, og alle kald er demobrugeren.
MCP_USER_KEYS=
# Server-til-server-nøgle til POST /api/send-to-lasso. Tom = ADMIN_API_KEY.
SEND_TO_LASSO_KEY=
# true = /e/<lassoId> kan åbnes uden signeret link (offentlige entitetssider = gratis opslag på servernøglen).
ENTITY_PAGES_PUBLIC=false
# true = portalen (/portal) er åben uden login; alle besøgende er demobrugeren (fælles liste af gemte sider).
PORTAL_PUBLIC=false

# Hardcodet demobruger, indtil Lasso ID kobles på.
DEMO_USER_ID=demo
DEMO_USER_NAME=Demobruger
DEMO_ORG=lasso-demo

# Lasso API
LASSO_API_BASE_URL=https://api.lassox.com
LASSO_API_USERNAME=
LASSO_API_PASSWORD=
# Lassos API-nøgle, sendt i headeren "lasso-api-key" (bekræftet mod api.lassox.com).
# På Railway peger den på ${{LASSO_API_PASSWORD}}, hvor nøglen blev lagt.
LASSO_API_TOKEN=
# "Authorization" sender "<scheme> <token>". Et andet headernavn sender token rent.
LASSO_API_TOKEN_HEADER=lasso-api-key
LASSO_API_AUTH_SCHEME=Bearer
# Sæt fx til "apikey" eller "code" for at sende token som query-parameter.
LASSO_API_TOKEN_QUERY=
# Lassos søgning (/apps/search/prompt og /apps/search/lassoid) på et andet miljø med egen nøgle.
LASSO_SEARCH_API_BASE_URL=https://dev3.api.lassox.com
LASSO_SEARCH_API_TOKEN=
# Tom = samme header som LASSO_API_TOKEN_HEADER
LASSO_SEARCH_API_TOKEN_HEADER=
LASSO_API_TIMEOUT_MS=15000
LASSO_CACHE_TTL_SECONDS=300
LASSO_COMPANY_ID_PREFIX=CVR-1-
# auto = live når der er credentials, ellers demodata. live | demo tvinger.
LASSO_DATA_SOURCE=auto
# Log strukturen (kun feltnavne) af Lassos svar ved opstart.
LASSO_STARTUP_PROBE=true
LASSO_STARTUP_PROBE_QUERY=lasso

# "Gem som PDF": Chromium, der laver PDF'erne på serveren. Findes filen ikke, er PDF slået fra
# (knappen skjules, PDF-ruterne svarer 503, /health viser pdf: false). Docker-billedet har /usr/bin/chromium.
PDF_CHROMIUM_PATH=/usr/bin/chromium
# Så længe må én PDF tage (ms).
PDF_TIMEOUT_MS=25000

# Lassos egen chat (/chat og /api/chat, docs/chat.md): Claude via Claude Platform med samme værktøjer
# som /mcp. Nøglen laves på platform.claude.com → API keys. Uden nøgle er chatten slået fra.
ANTHROPIC_API_KEY=
# claude-haiku-4-5 (nyeste Haiku, standard), claude-sonnet-5-5 eller claude-opus-5-5.
CHAT_MODEL=claude-haiku-4-5
# Højst så mange tokens pr. modelsvar (1024–128000). For lavt giver afbrudte svar og specs.
CHAT_MAX_TOKENS=16000
# low | medium | high | xhigh | max (bruges ikke med Haiku).
CHAT_EFFORT=medium
# Højst så mange beskeder pr. bruger pr. time.
CHAT_MAX_PER_HOUR=60
# Prompt-cachens levetid hos Claude Platform: 5m eller 1h (samme TTL på begge markører).
CHAT_CACHE_TTL=1h
# Så lang (tegn som JSON) må samtalen være, før serveren kaster de ældste hele ture.
CHAT_HISTORY_MAX_CHARS=400000
